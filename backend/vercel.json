{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun scripts/vercel-install.mjs",
  "buildCommand": "bun scripts/build-vercel.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ]
}
