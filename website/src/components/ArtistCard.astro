---
export interface Props {
  id: string
  displayName: string | null
  avatarUrl: string | null
  location: string | null
  hallSlug: string | null
  verified: boolean
  followersCount: number
}

const { id, displayName, avatarUrl, location, hallSlug, verified, followersCount } = Astro.props
const name = displayName ?? "Анонимный художник"
const link = hallSlug ? `/halls/${hallSlug}` : `/artists/${id}`
---

<a href={link} class="artist-card">
  <div class="artist-avatar">
    {avatarUrl ? <img src={avatarUrl} alt={name} /> : <div class="avatar-placeholder">{name[0]}</div>}
    {verified && <span class="verified-badge" title="Верифицирован">&#10003;</span>}
  </div>
  <div class="artist-info">
    <h3 class="artist-name">{name}</h3>
    {location && <p class="artist-location">{location}</p>}
    <p class="artist-followers">{followersCount} подписчиков</p>
  </div>
</a>

<style>
  .artist-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid color-mix(in oklab, var(--ink) 10%, transparent);
    text-decoration: none;
    color: var(--ink);
    transition: border-color .35s ease;
  }
  .artist-card:hover {
    border-color: color-mix(in oklab, var(--ink) 28%, transparent);
  }
  .artist-avatar {
    position: relative;
    width: 56px; height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }
  .artist-avatar img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .avatar-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: var(--iri-deep);
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--paper);
  }
  .verified-badge {
    position: absolute;
    bottom: 0; right: 0;
    width: 20px; height: 20px;
    background: var(--iri-deep);
    border-radius: 50%;
    font-size: .65rem;
    display: flex; align-items: center; justify-content: center;
    color: var(--paper);
  }
  .artist-info { min-width: 0; }
  .artist-name {
    font-family: var(--sans);
    font-size: .95rem;
    font-weight: 600;
  }
  .artist-location {
    font-family: var(--mono);
    font-size: .68rem;
    opacity: .6;
    letter-spacing: .04em;
  }
  .artist-followers {
    font-family: var(--mono);
    font-size: .64rem;
    opacity: .5;
    letter-spacing: .04em;
    margin-top: .1rem;
  }
</style>
