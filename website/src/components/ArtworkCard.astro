---
export interface Props {
  id: string
  title: string
  images: string[]
  category: string
  price: string | null
  currency: string
  artistName?: string | null
}

const { id, title, images, category, price, currency, artistName } = Astro.props
const img = images[0] ?? "/placeholder-art.svg"
const priceDisplay = price ? `${Number(price).toLocaleString()} ${currency}` : null
---

<a href={`/artworks/${id}`} class="card">
  <div class="card-image">
    <img src={img} alt={title} loading="lazy" />
    <span class="category-tag">{category}</span>
  </div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    {artistName && <p class="card-artist">{artistName}</p>}
    {priceDisplay && <p class="card-price">{priceDisplay}</p>}
  </div>
</a>

<style>
  .card {
    display: block;
    border: 1px solid color-mix(in oklab, var(--ink) 12%, transparent);
    text-decoration: none;
    color: var(--ink);
    transition: border-color .35s ease;
  }
  .card:hover {
    border-color: color-mix(in oklab, var(--ink) 30%, transparent);
  }
  .card-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: color-mix(in oklab, var(--ink) 5%, transparent);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .category-tag {
    position: absolute;
    top: .5rem;
    left: .5rem;
    font-family: var(--mono);
    font-size: .6rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: var(--paper);
    color: var(--ink);
    padding: .2rem .5rem;
    opacity: .8;
  }
  .card-body { padding: 1rem; }
  .card-title {
    font-family: var(--sans);
    font-size: .92rem;
    font-weight: 600;
    margin-bottom: .2rem;
  }
  .card-artist {
    font-family: var(--mono);
    font-size: .7rem;
    opacity: .6;
    letter-spacing: .04em;
  }
  .card-price {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 400;
    margin-top: .35rem;
    opacity: .85;
  }
</style>
