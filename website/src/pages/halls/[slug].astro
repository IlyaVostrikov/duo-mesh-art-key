---
export function getStaticPaths() {
  return [{ params: { slug: "view" } }];
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import GridLines from "../../components/GridLines.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageFooter from "../../components/PageFooter.astro";
---

<BaseLayout title="Выставочный зал" description="Виртуальный выставочный зал художника на DUO MESH.">
  <PageHeader />

  <!-- Контент -->
  <section class="sec paper pad-y">
    <div class="wrap">
      <GridLines />
      <div class="layer" id="hall-content">
        <p style="text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:3rem 0">Загрузка зала...</p>
      </div>
    </div>
  </section>

  <PageFooter />
</BaseLayout>

<script>
  const slug = window.location.pathname.split('/').pop()!
  const container = document.getElementById('hall-content')!

  async function load() {
    try {
      const hall = await window.api.halls.get(slug)
      container.innerHTML = `
        <a href="/artists" style="display:inline-block;margin-bottom:1.5rem;font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);opacity:.55;text-decoration:none">&larr; К художникам</a>
        <div style="margin-bottom:2rem">
          ${hall.coverImageUrl ? `<img src="${hall.coverImageUrl}" alt="${hall.title}" style="width:100%;max-height:400px;object-fit:cover;margin-bottom:1.5rem;border:1px solid color-mix(in oklab,var(--ink) 10%,transparent)" />` : ''}
          <h1 class="display sm" style="margin-bottom:.25rem">${hall.title}</h1>
          <p style="font-family:var(--sans);font-size:1rem;opacity:.7;margin-bottom:.75rem">${hall.artist.displayName ?? 'Художник'}</p>
          ${hall.description ? `<p style="font-family:var(--sans);font-size:.84rem;line-height:1.62;opacity:.8;max-width:720px">${hall.description}</p>` : ''}
          <p style="font-family:var(--mono);font-size:.66rem;opacity:.45;letter-spacing:.04em;margin-top:.5rem">${hall.viewCount} просмотров</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem">
          ${hall.artworks.length === 0 ? '<p style="grid-column:1/-1;text-align:center;opacity:.5;font-family:var(--mono);font-size:.7rem;padding:3rem 0">В зале пока нет работ</p>' :
            hall.artworks.map((aw: any) => `
              <a href="/artworks/${aw.id}" class="aw-card">
                <div class="aw-img">${aw.images[0] ? `<img src="${aw.images[0]}" alt="${aw.title}" loading="lazy" />` : '<div class="aw-noimg"></div>'}</div>
                <div class="aw-body"><h3>${aw.title}</h3>${aw.price ? `<p class="aw-price">${Number(aw.price).toLocaleString()} ${aw.currency}</p>` : ''}</div>
              </a>
            `).join('')
          }
        </div>`
    } catch (err) {
      container.innerHTML = `<p style="text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;padding:3rem 0">Ошибка: ${(err as Error).message}</p>`
    }
  }
  load()
</script>

<style>
  .aw-card { display:block; border:1px solid color-mix(in oklab,var(--ink) 12%,transparent); text-decoration:none; color:var(--ink); transition:border-color .35s; }
  .aw-card:hover { border-color:color-mix(in oklab,var(--ink) 30%,transparent); }
  .aw-img { aspect-ratio:4/3; overflow:hidden; background:color-mix(in oklab,var(--ink) 5%,transparent); }
  .aw-img img { width:100%; height:100%; object-fit:cover; }
  .aw-noimg { width:100%; height:100%; }
  .aw-body { padding:1rem; }
  .aw-body h3 { font-family:var(--sans); font-size:.92rem; font-weight:600; margin-bottom:.2rem; }
  .aw-price { font-family:var(--serif); font-size:1rem; font-weight:300; margin-top:.35rem; opacity:.85; }
</style>
