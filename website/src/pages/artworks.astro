---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridLines from "../components/GridLines.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";
---

<BaseLayout title="Каталог работ" description="Просматривайте произведения искусства от независимых художников на DUO MESH.">
  <PageHeader />

  <!-- Контент -->
  <section class="sec paper pad-y">
    <div class="wrap">
      <GridLines />
      <div class="layer">
        <div class="toprow">
          <h1 class="display sm">Каталог работ</h1>
          <div style="display:flex;gap:.75rem">
            <select id="filter-category" style="font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;background:transparent;border:1px solid color-mix(in oklab,var(--ink) 20%,transparent);padding:.5rem .75rem;color:var(--ink);cursor:pointer">
              <option value="">Все категории</option>
              <option value="PAINTING">Живопись</option>
              <option value="DIGITAL">Цифровое</option>
              <option value="PHOTOGRAPHY">Фотография</option>
              <option value="SCULPTURE">Скульптура</option>
              <option value="MIXED_MEDIA">Смешанная техника</option>
              <option value="PRINT">Принт</option>
              <option value="DRAWING">Графика</option>
              <option value="OTHER">Другое</option>
            </select>
            <select id="filter-sort" style="font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;background:transparent;border:1px solid color-mix(in oklab,var(--ink) 20%,transparent);padding:.5rem .75rem;color:var(--ink);cursor:pointer">
              <option value="newest">Сначала новые</option>
              <option value="popular">Популярные</option>
              <option value="price_asc">Цена ↑</option>
              <option value="price_desc">Цена ↓</option>
            </select>
          </div>
        </div>
        <div id="artwork-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem;margin-top:2rem">
          <p style="grid-column:1/-1;text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:3rem 0">Загрузка работ...</p>
        </div>
        <div id="pagination" style="display:flex;justify-content:center;gap:.5rem;margin-top:2rem"></div>
      </div>
    </div>
  </section>

  <PageFooter />
</BaseLayout>

<script>
  import { escapeHtml } from '../lib/escape-html'

  let page = 1
  const grid = document.getElementById('artwork-grid')!
  const pagination = document.getElementById('pagination')!
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement
  const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement

  async function loadArtworks() {
    grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:3rem 0">Загрузка...</p>'
    try {
      const data = await window.api.artworks.list({
        page: String(page),
        pageSize: '12',
        category: categorySelect.value,
        sort: sortSelect.value,
      })
      if (data.artworks.length === 0) {
        grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;padding:3rem 0">Работы не найдены</p>'
        pagination.innerHTML = ''
        return
      }
      grid.innerHTML = data.artworks.map((aw: any) => {
        const img = aw.images[0] ?? '/placeholder-art.svg'
        const price = aw.price ? `${Number(aw.price).toLocaleString()} ${aw.currency}` : ''
        return `<a href="/artworks/${aw.id}" class="aw-card">
          <div class="aw-img"><img src="${escapeHtml(img)}" alt="${escapeHtml(aw.title)}" loading="lazy" /><span class="aw-tag">${escapeHtml(aw.category)}</span></div>
          <div class="aw-body"><h3>${escapeHtml(aw.title)}</h3><p class="aw-artist">${escapeHtml(aw.artist?.displayName ?? '')}</p>${price ? `<p class="aw-price">${price}</p>` : ''}</div>
        </a>`
      }).join('')
      pagination.innerHTML = ''
      if (data.total > data.pageSize) {
        const totalPages = Math.ceil(data.total / data.pageSize)
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button')
          btn.textContent = String(i)
          btn.style.cssText = `font-family:var(--mono);font-size:.7rem;padding:.4rem .9rem;border:1px solid color-mix(in oklab,var(--ink) 20%,transparent);background:${i === page ? 'var(--ink)' : 'transparent'};color:${i === page ? 'var(--paper)' : 'var(--ink)'};cursor:pointer`
          btn.onclick = () => { page = i; loadArtworks(); window.scrollTo(0, 0) }
          pagination.appendChild(btn)
        }
      }
    } catch (err) {
      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;padding:3rem 0">Ошибка загрузки: ${(err as Error).message}</p>`
    }
  }

  categorySelect.addEventListener('change', () => { page = 1; loadArtworks() })
  sortSelect.addEventListener('change', () => { page = 1; loadArtworks() })
  loadArtworks()
</script>

<style>
  .aw-card { display:block; border:1px solid color-mix(in oklab,var(--ink) 12%,transparent); text-decoration:none; color:var(--ink); transition:border-color .35s; }
  .aw-card:hover { border-color:color-mix(in oklab,var(--ink) 30%,transparent); }
  .aw-img { position:relative; aspect-ratio:4/3; overflow:hidden; background:color-mix(in oklab,var(--ink) 5%,transparent); }
  .aw-img img { width:100%; height:100%; object-fit:cover; }
  .aw-tag { position:absolute; top:.5rem; left:.5rem; font-family:var(--mono); font-size:.6rem; letter-spacing:.08em; text-transform:uppercase; background:var(--paper); color:var(--ink); padding:.2rem .5rem; opacity:.8; }
  .aw-body { padding:1rem; }
  .aw-body h3 { font-family:var(--sans); font-size:.92rem; font-weight:600; margin-bottom:.2rem; }
  .aw-artist { font-family:var(--mono); font-size:.7rem; opacity:.6; letter-spacing:.04em; }
  .aw-price { font-family:var(--serif); font-size:1rem; font-weight:400; margin-top:.35rem; opacity:.85; }
</style>
