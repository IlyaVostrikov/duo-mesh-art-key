---
export function getStaticPaths() {
  return [{ params: { id: "view" } }];
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import GridLines from "../../components/GridLines.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageFooter from "../../components/PageFooter.astro";
---

<BaseLayout title="Работа" description="Детальная информация о произведении искусства.">
  <PageHeader />

  <!-- Контент -->
  <section class="sec paper pad-y">
    <div class="wrap">
      <GridLines />
      <div class="layer" id="artwork-detail">
        <p style="text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:3rem 0">Загрузка...</p>
      </div>
    </div>
  </section>

  <PageFooter />
</BaseLayout>

<script>
  import { escapeHtml } from '../../lib/escape-html'

  const id = window.location.pathname.split('/').pop()!
  const container = document.getElementById('artwork-detail')!

  async function load() {
    try {
      const aw = await window.api.artworks.get(id)

      const images = aw.images.length > 0
        ? aw.images.map((img: string, i: number) =>
            `<img src="${escapeHtml(img)}" alt="${escapeHtml(aw.title)} — ${i + 1}" class="aw-main-img" ${i > 0 ? 'loading="lazy" style="width:80px;height:60px;object-fit:cover;margin:.5rem .5rem 0 0;cursor:pointer"' : ''} />`
          ).join('')
        : '<div class="aw-no-img">Нет изображения</div>'

      const price = aw.price ? `${Number(aw.price).toLocaleString()} ${aw.currency}` : 'Цена не указана'

      container.innerHTML = `
        <a href="/artworks" style="display:inline-block;margin-bottom:1.5rem;font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);opacity:.55;text-decoration:none">&larr; Назад к каталогу</a>
        <div class="aw-layout">
          <div class="aw-images">${images}</div>
          <div class="aw-info">
            <h1 class="display xs" style="margin-bottom:.5rem">${escapeHtml(aw.title)}</h1>
            ${aw.artist ? `<a href="/artists/${aw.artist.id}" style="font-family:var(--sans);font-size:.9rem;color:var(--ink);opacity:.7">${escapeHtml(aw.artist.displayName ?? 'Художник')}</a>` : ''}
            ${aw.year ? `<p style="font-family:var(--mono);font-size:.66rem;opacity:.5;letter-spacing:.05em;margin:.5rem 0">${escapeHtml(aw.year)}${aw.medium ? ' · ' + escapeHtml(aw.medium) : ''}${aw.dimensions ? ' · ' + escapeHtml(aw.dimensions) : ''}</p>` : ''}
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin:.75rem 0">${aw.styleTags.map((t: string) => `<span class="aw-tag">${escapeHtml(t)}</span>`).join(' ')}</div>
            ${aw.description ? `<p style="font-family:var(--sans);font-size:.84rem;line-height:1.62;opacity:.8;margin:1rem 0">${escapeHtml(aw.description)}</p>` : ''}
            <div class="aw-price-block">
              <span class="aw-price">${price}</span>
              <span style="font-family:var(--mono);font-size:.66rem;opacity:.5">${aw.editionType === 'UNIQUE' ? 'Уникат' : aw.editionType === 'LIMITED' ? `Тираж: ${escapeHtml(aw.editionTotal)}` : 'Открытый тираж'}</span>
            </div>
            ${aw.artKey ? `<div class="aw-keyinfo"><span style="font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase">Art Key</span><code style="font-family:var(--mono);font-size:.7rem;display:block;margin:.4rem 0;opacity:.7;word-break:break-all">${escapeHtml(aw.artKey.keyCode)}</code><p style="font-family:var(--mono);font-size:.66rem;opacity:.5">Владелец: ${escapeHtml(aw.artKey.ownerKey)}</p></div>` : ''}
            ${aw.latestProvenance ? `<div style="margin:1rem 0"><h3 style="font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.25rem">Последняя передача</h3><p style="font-family:var(--mono);font-size:.7rem;opacity:.6">${escapeHtml(aw.latestProvenance.transferType)} → ${escapeHtml(aw.latestProvenance.toOwnerName ?? 'неизвестно')} (${new Date(aw.latestProvenance.createdAt).toLocaleDateString('ru')})</p></div>` : ''}
            <div class="aw-contact">
              <h3 style="font-family:var(--serif);font-size:1.2rem;font-weight:300;margin-bottom:.25rem">Хочу купить</h3>
              <p style="font-family:var(--mono);font-size:.66rem;opacity:.5;margin-bottom:1rem">Оставьте контакты — художник свяжется с вами.</p>
              <form id="inquiry-form">
                <input type="text" id="inq-name" placeholder="Ваше имя" required class="aw-input" />
                <input type="email" id="inq-email" placeholder="Email" required class="aw-input" />
                <textarea id="inq-message" placeholder="Сообщение художнику (по желанию)" rows="3" class="aw-input"></textarea>
                <button type="submit" id="inq-submit" class="aw-btn">Отправить</button>
              </form>
              <p id="inq-status" style="margin-top:.5rem;font-family:var(--mono);font-size:.66rem"></p>
            </div>
          </div>
        </div>`

      document.getElementById('inquiry-form')!.addEventListener('submit', async (e) => {
        e.preventDefault()
        const btn = document.getElementById('inq-submit') as HTMLButtonElement
        const status = document.getElementById('inq-status')!
        btn.disabled = true
        btn.textContent = 'Отправка...'
        try {
          await window.api.inquiries.create({
            artworkId: id,
            fromName: (document.getElementById('inq-name') as HTMLInputElement).value,
            fromEmail: (document.getElementById('inq-email') as HTMLInputElement).value,
            message: (document.getElementById('inq-message') as HTMLTextAreaElement).value || undefined,
          })
          status.textContent = '✓ Сообщение отправлено! Художник свяжется с вами.'
          status.style.color = 'var(--iri-deep)'
        } catch (err) {
          status.textContent = `Ошибка: ${(err as Error).message}`
          status.style.color = '#c44'
        } finally {
          btn.disabled = false
          btn.textContent = 'Отправить'
        }
      })
    } catch (err) {
      container.innerHTML = `<p style="text-align:center;opacity:.55;font-family:var(--mono);font-size:.7rem;padding:3rem 0">Ошибка загрузки: ${(err as Error).message}</p>`
    }
  }
  load()
</script>

<style>
  .aw-layout { display:grid; grid-template-columns:1fr 1fr; gap:2rem; }
  @media(max-width:768px) { .aw-layout { grid-template-columns:1fr; } }
  .aw-images .aw-main-img:first-child { width:100%; }
  .aw-no-img { aspect-ratio:4/3; border:1px solid color-mix(in oklab,var(--ink) 10%,transparent); display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:.66rem; opacity:.5; }
  .aw-tag { font-family:var(--mono); font-size:.62rem; letter-spacing:.06em; text-transform:uppercase; border:1px solid color-mix(in oklab,var(--ink) 15%,transparent); padding:.2rem .6rem; opacity:.7; }
  .aw-price-block { margin:1.5rem 0; padding:1rem; border:1px solid color-mix(in oklab,var(--ink) 12%,transparent); display:flex; justify-content:space-between; align-items:center; }
  .aw-price { font-family:var(--serif); font-size:1.5rem; font-weight:300; }
  .aw-keyinfo { margin:1rem 0; padding:1rem; border:1px solid color-mix(in oklab,var(--iri-deep) 30%,transparent); }
  .aw-contact { margin-top:2rem; padding:1.5rem; border:1px solid color-mix(in oklab,var(--ink) 12%,transparent); }
  .aw-input { width:100%; padding:.75rem; margin-bottom:.75rem; background:transparent; border:1px solid color-mix(in oklab,var(--ink) 15%,transparent); font-family:var(--sans); font-size:.84rem; color:var(--ink); }
  .aw-input::placeholder { color:color-mix(in oklab,var(--ink) 30%,transparent); font-family:var(--mono); font-size:.7rem; }
  .aw-btn { font-family:var(--sans); font-weight:600; font-size:.78rem; letter-spacing:.06em; text-transform:uppercase; padding:.7rem 1.8rem; background:var(--ink); color:var(--paper); border:none; cursor:pointer; }
  .aw-btn:hover { opacity:.85; }
  .aw-btn:disabled { opacity:.4; cursor:not-allowed; }
</style>
