---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridLines from "../components/GridLines.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";
---

<BaseLayout title="О платформе" description="DUO MESH — экосистема для независимых художников с цифровыми сертификатами подлинности Art Key.">
  <PageHeader />

  <!-- Контент -->
  <section class="sec paper pad-y">
    <div class="wrap">
      <GridLines />
      <div class="layer">
        <h1 class="display sm rv">О платформе</h1>

        <div class="row rv" style="margin-top:clamp(40px,6vw,72px)">
          <div>
            <h2 class="display xs" style="margin-bottom:1rem">Что такое DUO MESH</h2>
            <p class="body" style="max-width:48ch;text-align:left;margin-bottom:1rem">DUO MESH — это не маркетплейс. Это город искусства, где у каждого художника есть свой дом, а улицы — это выставки.</p>
            <p class="body" style="max-width:48ch;text-align:left">Мы создаём экосистему, в которой независимые художники получают полноценное виртуальное присутствие: персональный выставочный зал, цифровые сертификаты подлинности на каждую работу и прямую связь с покупателями.</p>
          </div>
          <div>
            <h2 class="display xs" style="margin-bottom:1rem">Art Key — цифровой паспорт</h2>
            <p class="body" style="max-width:48ch;text-align:left;margin-bottom:1rem">Каждая работа на платформе получает уникальный идентификатор Art Key — криптографически защищённый сертификат, который подтверждает подлинность произведения и отслеживает историю владения.</p>
            <p class="body" style="max-width:48ch;text-align:left">Это не NFT — это практичная система для реального искусства: физического и цифрового.</p>
          </div>
        </div>

        <div class="row rv" style="margin-top:clamp(40px,6vw,72px)">
          <div style="border:1px solid color-mix(in oklab,var(--ink) 12%,transparent);padding:clamp(26px,4vw,40px)">
            <h2 class="display xs" style="margin-bottom:1rem">Для художников</h2>
            <ul class="namelist" style="list-style:none;line-height:2.2">
              <li>— Бесплатный выставочный зал</li>
              <li>— Прямой контакт с покупателями</li>
              <li>— Сертификаты подлинности на каждую работу</li>
              <li>— Отслеживание провенанса</li>
              <li>— Премьеры и события</li>
            </ul>
          </div>
          <div style="border:1px solid color-mix(in oklab,var(--ink) 12%,transparent);padding:clamp(26px,4vw,40px)">
            <h2 class="display xs" style="margin-bottom:1rem">Для коллекционеров</h2>
            <ul class="namelist" style="list-style:none;line-height:2.2">
              <li>— Прямой контакт с художниками</li>
              <li>— Проверка подлинности через Art Key</li>
              <li>— История владения каждой работы</li>
              <li>— Виртуальные прогулки по залам</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PageFooter />
</BaseLayout>
